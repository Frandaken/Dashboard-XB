# Dashboard-XB Backend Environment Configuration
PORT=3003
NODE_ENV=production

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security: Admin Secret Key for triggering manual broadcasts & routine push notifications
# If set, calls to /api/push/send-routine and /api/push/broadcast require: Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY="your-secret-admin-token-here"

# Wajib: Google Calendar iCal private feed URLs (hanya diambil dari .env, tidak hardcoded)
# CALENDAR_FEED_BIRTHDAY berisi satu kalender ulang tahun gabungan
CALENDAR_FEED_PELAJARAN="https://calendar.google.com/calendar/ical/<pelajaran-id>%40group.calendar.google.com/private-<token>/basic.ics"
CALENDAR_FEED_BIRTHDAY="https://calendar.google.com/calendar/ical/<birthday-id>%40group.calendar.google.com/private-<token>/basic.ics"

# Web Push VAPID Keypair (auto-generated in data/vapid.json if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Nomor Versi Aplikasi (Frontend)
VITE_APP_VERSION="v1.0.0"

# Aktifkan Docker Buildx Bake otomatis (aktifkan hanya jika docker-buildx-plugin sudah terpasang)
# COMPOSE_BAKE=true
